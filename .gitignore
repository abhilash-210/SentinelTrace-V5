# ==================================================
# SENTINEL-TRACE .gitignore
# ==================================================

# Environment & Credentials — NEVER commit
.env
*.env
!.env.example

# Databases & Runtime State (SQLite local runtime databases)
*.db
*.sqlite
*.sqlite3
*.db-journal
sentinel_trace.db
test_sentinel.db
backend/*.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
backend/.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Docker & Storage
postgres_data/
.tempmediaStorage/

# OS Generated
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo

# Temporary logs
*.log
