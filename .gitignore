# ==================================================
# SentinelTrace V5 — .gitignore
# ==================================================

# ── Environment & Credentials — NEVER commit ──────
.env
*.env
!.env.example

# ── Databases & Runtime State ──────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
sentinel_trace.db
test_sentinel.db
backend/*.db

# ── Python ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
backend/.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Node & Frontend ────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ── Docker & Storage ───────────────────────────────
postgres_data/
.tempmediaStorage/

# ── Generated Outputs (keep directory, not files) ──
outputs/*
!outputs/.gitkeep
backend/outputs/*
!backend/outputs/.gitkeep

# ── Test Artifacts ─────────────────────────────────
*.log
*.txt
!requirements.txt
!backend/requirements.txt
report.xml
pytest_output*
backend/report.xml
backend/pytest_output*
backend/test_*_err.txt
backend/test_*.log

# ── OS Generated ───────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE & Editor ───────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Temporary / Development Clutter ───────────────
scratch/
SPRINT_03B_FREEZE.md
walkthrough.md
OPEN_DASHBOARD.url
PROJECT_STATE.md
FINAL_ARCHITECTURE.md
SCREENSHOT_MANIFEST.md
ABHILASH_REPORT.md
